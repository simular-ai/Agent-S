<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Required for PRI/XAML resource indexing even when WindowsPackageType is None. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Indigo release artwork generated from app/macos/Resources/Icon/AppIcon.png. -->
    <ApplicationIcon>Assets\AgentS.ico</ApplicationIcon>
    <!-- The Agent S release this build belongs to; Settings › Check for Updates… compares against it. -->
    <Version>0.3.3</Version>
    <!-- Dev (the default) builds "Agent S Dev" with its own data folder and Private computer (see AppIdentity.cs).
         The release workflow passes -p:AgentSChannel=Release to build "Agent S". -->
    <AgentSChannel Condition="'$(AgentSChannel)' == ''">Dev</AgentSChannel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AgentSChannel)' != 'Release'">
    <!-- Black development artwork. -->
    <ApplicationIcon>Assets\AgentS-Dev.ico</ApplicationIcon>
    <Product>Agent S Dev</Product>
    <AssemblyTitle>Agent S Dev</AssemblyTitle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AgentSChannel)' == 'Release'">
    <Product>Agent S</Product>
    <AssemblyTitle>Agent S</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AgentSChannel" Value="$(AgentSChannel)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="../AgentS.Core/AgentS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Guest desktop scripts installed into the WSL Private computer during in-app setup. -->
    <Content Include="../scripts/agent-s-guest.sh;../scripts/agent-s-desktop.sh;../scripts/agent-s-dock.sh;../scripts/agent-s-demo.html"
             Link="Guest/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Coding-agent harness tools (web, ui, Ollama relay), installed before the first harness turn. -->
    <Content Include="../scripts/guest-tools/*" Link="Guest/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- This PC tools: the `pc` UI Automation tool and the approval hook, written to LocalAppData each turn. -->
    <Content Include="../scripts/pc-tools/*" Link="PcTools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../scripts/this-pc.patch.yml;../scripts/deepseek-live-text.mjs;../../macos/DeepSeekRuntime/package.json;../../macos/DeepSeekRuntime/package-lock.json"
             Link="DeepSeekRuntime/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AgentS.ico;Assets\AgentS.png;Assets\AgentS-Dev.ico;Assets\AgentS-Dev.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Publishing must run the SDK resource target, not just managed compilation. -->
  <Target Name="BuildXamlResourceIndex" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="GenerateProjectPriFile" />
</Project>
