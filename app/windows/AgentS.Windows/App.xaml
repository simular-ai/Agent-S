          <SolidColorBrush x:Key="AccentButtonBackground" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D9D9D9" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#BFBFBF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F2F2F2" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D9D9D9" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#BFBFBF" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F2F2F2" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D9D9D9" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#BFBFBF" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#F2F2F2" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#D9D9D9" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#BFBFBF" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#F2F2F2" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D9D9D9" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#BFBFBF" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#F2F2F2" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#F2F2F2" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#F2F2F2" />
          <SolidColorBrush x:Key="ProgressBarForeground" Color="#F2F2F2" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#262626" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#333333" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#262626" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#333333" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#262626" />
          <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#262626" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorder}" />
      </Style>
      <Style x:Key="CircleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
      </Style>
      <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
