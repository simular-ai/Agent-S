          <SolidColorBrush x:Key="AccentButtonBackground" Color="#111111" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#333333" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#000000" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#111111" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#333333" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#000000" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#111111" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#333333" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#000000" />
