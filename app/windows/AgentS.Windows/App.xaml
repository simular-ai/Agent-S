          <SolidColorBrush x:Key="BubbleForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ChipBackground" Color="#F1F1F1" />
          <SolidColorBrush x:Key="MutedText" Color="#626262" />
          <SolidColorBrush x:Key="CodeText" Color="#B4235A" />
          <!-- macOS uses black (white in dark mode) as its only accent: no brand blue. -->
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#111111" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#333333" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#555555" />
