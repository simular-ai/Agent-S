<Application x:Class="AgentS.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Merged after the WinUI resources so these (the macOS palette and its black/white accent) win over them. -->
        <ResourceDictionary>
      <!-- Agent S palette, matched to the macOS app. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBackground" Color="#F6F6F6" />
          <SolidColorBrush x:Key="ChatBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E4E4E4" />
