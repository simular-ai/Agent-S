          <SolidColorBrush x:Key="CardBorder" Color="#333333" />
          <SolidColorBrush x:Key="DividerBrush" Color="#2E2E2E" />
          <SolidColorBrush x:Key="BubbleBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BubbleForeground" Color="#000000" />
          <SolidColorBrush x:Key="ChipBackground" Color="#262626" />
          <SolidColorBrush x:Key="MutedText" Color="#B0B0B0" />
          <SolidColorBrush x:Key="CodeText" Color="#F28BB0" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D9D9D9" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#BFBFBF" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC000000" />
