          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#111111" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#111111" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#111111" />
          <SolidColorBrush x:Key="ProgressBarForeground" Color="#111111" />
          <!-- Solid popups: WinUI's acrylic lets the fields behind a dropdown or menu show through its items. -->
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E4E4E4" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E4E4E4" />
