# Copy to .env and fill in. .env is gitignored; this template is not.
# agent_s4.eval.scienceboard_prime calls load_dotenv() at import, so
# everything here reaches the eval process -- and the Builder subprocess,
# which inherits os.environ. Keep every line KEY=value.

# --- Model endpoint for Prime Agent (Builder and task agent) -------------
# The launcher's model is openai/$OPENAI_MODEL (SHADOW_EVOL_MODEL overrides).
OPENAI_API_KEY=...
OPENAI_BASE_URL=https://<your-openai-compatible-endpoint>/v1
OPENAI_MODEL=<deployment>
# Base URL the task VMs use to reach the endpoint, when it differs from the
# host's (e.g. a LiteLLM proxy reached by its private address).
# SHADOW_EVOL_VM_OPENAI_BASE_URL=http://<host>:4000/v1

# --- AWS (required for any run) ------------------------------------------
# Export these or uncomment them here; the launchers read either.
# Credentials come from SSO or your usual AWS config, not from here.
# AWS_PROFILE=<profile>
# AWS_REGION=us-east-1
# The task VMs' subnet and security group. The group must admit this host on
# the guest daemon (5000) and the app REST port (8000).
# AWS_SUBNET_ID=subnet-...
# AWS_SECURITY_GROUP_ID=sg-...
# Every launched instance is tagged Owner=<value>; any value works.
# SHADOW_EVOL_OWNER_TAG=<owner>

# --- ScienceBoard ---------------------------------------------------------
# A ScienceBoard AMI in your account (see README.md).
# SB_AMI_ID=ami-...
# SB_INSTANCE_TYPE=t3.large
# SB_CLIENT_PASSWORD=osworld-public-evaluation
